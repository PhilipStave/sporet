# Supabase — from your project's API settings (https://app.supabase.com -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — server-only, used for company setup & invite acceptance.
# NEVER expose this to the browser. Keep it out of NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL used in invite links (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://altiv.no
