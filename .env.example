# Supabase — from your project's API settings (https://app.supabase.com -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — server-only, used for company setup & invite acceptance.
# NEVER expose this to the browser. Keep it out of NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL used in invite links (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://altiv.no

# ---- Stripe (betaling) ----
# Fra https://dashboard.stripe.com/apikeys  (bruk test-nøkler mens du tester)
STRIPE_SECRET_KEY=sk_test_...
# Fra Developers -> Webhooks -> endepunktet ditt -> "Signing secret"
STRIPE_WEBHOOK_SECRET=whsec_...
# Pris-ID-er (price_...) for hver pakke, fra Product catalog i Stripe
STRIPE_PRICE_10=price_...
STRIPE_PRICE_20=price_...
STRIPE_PRICE_50=price_...
STRIPE_PRICE_100=price_...
